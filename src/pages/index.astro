---
import Base from "../layouts/Base.astro";
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import flightArt from "../assets/music/flight-of-the-white-dragon.jpg";
import ladderArt from "../assets/music/the-ladder.jpg";

const projects = [
  {
    name: "typedframes",
    blurb:
      "A Rust-fast static analysis linter for pandas/polars DataFrames. Catches column-access errors at lint time, with an opt-in coverage gate for CI.",
    links: [
      { label: "GitHub", href: "https://github.com/w-martin/typedframes" },
      { label: "PyPI", href: "https://pypi.org/project/typedframes/" },
    ],
  },
  {
    name: "trustedlicenses",
    blurb:
      "A Python/Rust CLI that checks every installed package's license against a policy you configure, so CI can gate a build on license compliance.",
    links: [
      { label: "GitHub", href: "https://github.com/w-martin/trustedlicenses" },
      { label: "PyPI", href: "https://pypi.org/project/trustedlicenses/" },
    ],
  },
];

const recentPosts = (await getCollection("blog"))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
---

<Base title="Home">
  <!-- First-draft copy -- edit freely. -->
  <h1 class="font-sans text-3xl font-bold text-black dark:text-white mb-6">Hi, I'm Will.</h1>

  <p class="mb-4">
    I'm a PhD computer scientist and ML engineer, currently tech lead for ML
    infrastructure at giffgaff.
  </p>

  <ul class="flex flex-wrap gap-x-6 gap-y-2 font-sans text-sm mb-16">
    <li><a href="https://github.com/w-martin" class="text-body hover:text-accent">GitHub</a></li>
    <li><a href="https://linkedin.com/in/wil-martin" class="text-body hover:text-accent">LinkedIn</a></li>
    <li><a href="https://pypi.org/user/will-martin" class="text-body hover:text-accent">PyPI</a></li>
  </ul>

  <section id="projects" class="scroll-mt-8 mb-16">
    <h2 class="font-sans text-2xl font-bold text-black dark:text-white mb-2 pb-2 border-b border-rule">Projects</h2>
    <p class="mb-6">Independent research and open-source tooling in Rust and Python.</p>
    <div class="flex flex-col gap-8">
      {projects.map((p) => (
        <article>
          <h3 class="font-sans text-lg font-bold text-black dark:text-white mb-2">{p.name}</h3>
          <p class="mb-3">{p.blurb}</p>
          <ul class="flex gap-4 font-sans text-sm">
            {p.links.map((l) => (
              <li><a href={l.href} class="text-accent">{l.label}</a></li>
            ))}
          </ul>
        </article>
      ))}
    </div>
  </section>

  <section id="music" class="scroll-mt-8 mb-16">
    <h2 class="font-sans text-2xl font-bold text-black dark:text-white mb-2 pb-2 border-b border-rule">Music</h2>
    <p class="mb-4">
      Away from the keyboard, I write and record instrumental guitar music, self-released.
    </p>

    <div class="flex flex-wrap gap-3 mb-8">
      <a
        href="https://will-martin.bandcamp.com"
        class="inline-block font-sans text-sm px-4 py-2 border border-accent text-accent rounded hover:bg-accent hover:text-white transition-colors"
      >
        Listen on Bandcamp
      </a>
      <a
        href="https://open.spotify.com/artist/3lTPmRwT3ZVgIRjzzzuxOS"
        class="inline-block font-sans text-sm px-4 py-2 border border-accent text-accent rounded hover:bg-accent hover:text-white transition-colors"
      >
        Listen on Spotify
      </a>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-8">
      <article>
        <Image
          src={ladderArt}
          alt="The Ladder cover art"
          width={500}
          height={500}
          class="w-full aspect-square object-cover rounded mb-3"
        />
        <p class="font-sans font-bold text-black dark:text-white mb-3">The Ladder</p>
        <iframe
          style="border: 0; width: 100%; height: 120px;"
          src="https://bandcamp.com/EmbeddedPlayer/track=2406607306/size=large/bgcol=ffffff/linkcol=2079c7/tracklist=false/artwork=small/transparent=true/"
          seamless
          title="The Ladder: Bandcamp player"
        >
        </iframe>
      </article>

      <article>
        <Image
          src={flightArt}
          alt="Flight of the White Dragon cover art"
          width={500}
          height={500}
          class="w-full aspect-square object-cover rounded mb-3"
        />
        <p class="font-sans font-bold text-black dark:text-white mb-3">Flight of the White Dragon</p>
        <iframe
          style="border: 0; width: 100%; height: 120px;"
          src="https://bandcamp.com/EmbeddedPlayer/track=580727493/size=large/bgcol=ffffff/linkcol=2079c7/tracklist=false/artwork=small/transparent=true/"
          seamless
          title="Flight of the White Dragon: Bandcamp player"
        >
        </iframe>
      </article>
    </div>
  </section>

  <section id="writing" class="scroll-mt-8">
    <h2 class="font-sans text-2xl font-bold text-black dark:text-white mb-2 pb-2 border-b border-rule">Writing</h2>
    {recentPosts.length === 0 ? (
      <p>Nothing published yet. Check back soon.</p>
    ) : (
      <ul class="flex flex-col gap-4 mt-4">
        {recentPosts.map((post) => (
          <li>
            <a href={`/blog/${post.id}/`} class="font-sans font-bold text-black dark:text-white hover:text-accent">
              {post.data.title}
            </a>
            <p class="font-sans text-sm text-body">
              {post.data.date.toLocaleDateString("en-GB", { year: "numeric", month: "long", day: "numeric" })}
            </p>
          </li>
        ))}
      </ul>
    )}
    <p class="mt-6"><a href="/blog/" class="text-accent font-sans text-sm">All posts</a></p>
  </section>
</Base>
