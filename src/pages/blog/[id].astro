---
import Base from "../../layouts/Base.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({
    params: { id: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<Base title={post.data.title} description={post.data.description}>
  <article>
    <h1 class="font-sans text-3xl font-bold text-black dark:text-white mb-2">{post.data.title}</h1>
    <p class="font-sans text-sm text-body mb-8">
      {post.data.date.toLocaleDateString("en-GB", { year: "numeric", month: "long", day: "numeric" })}
    </p>
    <div class="prose prose-neutral max-w-none prose-headings:font-sans prose-a:text-accent">
      <Content />
    </div>
  </article>
</Base>
