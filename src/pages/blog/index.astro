---
import Base from "../../layouts/Base.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
---

<Base title="Blog" description="Occasional writing by Will Martin.">
  <h1 class="font-sans text-3xl font-bold text-black dark:text-white mb-6">Blog</h1>

  {posts.length === 0 ? (
    <p>Nothing published yet. Check back soon.</p>
  ) : (
    <ul class="flex flex-col gap-6">
      {posts.map((post) => (
        <li class="border-b border-rule pb-6 last:border-0">
          <a href={`/blog/${post.id}/`} class="font-sans text-xl font-bold text-black dark:text-white hover:text-accent">
            {post.data.title}
          </a>
          <p class="font-sans text-sm text-body">
            {post.data.date.toLocaleDateString("en-GB", { year: "numeric", month: "long", day: "numeric" })}
          </p>
          {post.data.description && <p class="mt-2">{post.data.description}</p>}
        </li>
      ))}
    </ul>
  )}
</Base>
