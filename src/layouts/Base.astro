---
import "../styles/global.css";
import merriweatherRegular from "../assets/fonts/merriweather-400.woff2?url";
import openSans from "../assets/fonts/opensans-variable.woff2?url";

interface Props {
  title: string;
  description?: string;
}

const { title, description = "Will Martin: ML engineer, researcher, musician." } = Astro.props;

// Identity links only. No employer or job title, so this never goes stale; alternateName ties the papers published as William Martin to this person.
const person = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Will Martin",
  alternateName: "William Martin",
  url: "https://willmartin.uk",
  alumniOf: { "@type": "CollegeOrUniversity", name: "University College London", sameAs: "https://www.ucl.ac.uk" },
  knowsAbout: ["MLOps", "Systems engineering", "Machine learning", "Python", "Rust", "Empirical software engineering"],
  sameAs: [
    "https://linkedin.com/in/willmartinuk",
    "https://github.com/w-martin",
    "https://pypi.org/user/will-martin",
    "https://scholar.google.co.uk/citations?user=OXYi23sAAAAJ&hl=en",
  ],
};

const nav = [
  {
    href: "/#software",
    label: "Software",
    icon: "M6 8l-4 4 4 4M18 8l4 4-4 4M14 4l-4 16",
  },
  {
    href: "/#music",
    label: "Music",
    icon: "M9 18V5l12-2v13M9 18a3 3 0 11-6 0 3 3 0 016 0zM21 16a3 3 0 11-6 0 3 3 0 016 0z",
  },
  {
    href: "/#blog",
    label: "Blog",
    icon: "M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5M18.5 2.5a2.121 2.121 0 013 3L12 15l-4 1 1-4 9.5-9.5z",
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="only light" />
    <title>{title} | Will Martin</title>
    <meta name="description" content={description} />
    <script type="application/ld+json" set:html={JSON.stringify(person)} />
    <link rel="icon" href="/favicon.ico?v=9" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png?v=9" />
    <!-- Cloudflare Web Analytics -->
    <script type="module" src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon='{"token": "072668fef6c24a439973530b7a9f7937"}'></script>
    <!-- End Cloudflare Web Analytics -->
    <link rel="preload" href={merriweatherRegular} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={openSans} as="font" type="font/woff2" crossorigin />
    <script is:inline>
      // Set theme before paint, to avoid a flash of the wrong theme.
      (function () {
        document.documentElement.classList.add("js");
        const stored = localStorage.getItem("theme");
        const prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
        // Motion: the visitor's saved choice wins; otherwise follow the OS "reduce motion" setting.
        let motion = null;
        try {
          motion = localStorage.getItem("motion");
        } catch {}
        document.documentElement.dataset.motion =
          motion === "full" || motion === "calm"
            ? motion
            : window.matchMedia("(prefers-reduced-motion: reduce)").matches
              ? "calm"
              : "full";
        const prefersLight = window.matchMedia("(prefers-color-scheme: light)").matches;
        // a saved choice wins; otherwise follow the device setting, and fall back to dark if it has none
        const dark = stored === "dark" || (!stored && (prefersDark || !prefersLight));
        if (dark) document.documentElement.classList.add("dark");
        // Declare only the scheme in use: "light dark" lets Samsung Internet
        // decide the page already handles dark and skip its own handling wrongly.
        document.querySelector('meta[name="color-scheme"]').content = dark ? "dark" : "only light";
      })();
    </script>
  </head>
  <body class="min-h-screen flex flex-col bg-paper transition-colors">
    <header id="site-header" class="no-anim sticky top-0 z-[60] border-b border-rule bg-bar/90 backdrop-blur transition-colors duration-300">
      <nav id="site-nav" class="max-w-3xl mx-auto flex items-center justify-between gap-3 sm:gap-4 px-4 py-4 transition-[padding] duration-300">
        <a href="/" class="bar-link font-sans font-bold text-strong no-underline shrink-0">Will Martin</a>
        <a
          id="now-playing"
          href="#bandcamp-player"
          class="hidden items-center gap-1.5 text-sm text-body bar-link no-underline min-w-0 flex-1"
        >
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-4 h-4 flex-shrink-0">
            <path d="M9 18V5l12-2v13M9 18a3 3 0 11-6 0 3 3 0 016 0zM21 16a3 3 0 11-6 0 3 3 0 016 0z" />
          </svg>
          <span id="now-playing-title" class="truncate"></span>
        </a>
        <div class="flex items-center gap-4 sm:gap-6 shrink-0">
          <ul id="nav-links" class="flex items-center gap-x-4 sm:gap-x-6 font-sans text-sm">
            {nav.map((item) => (
              <li>
                <a href={item.href} class="nav-link text-body bar-link no-underline flex items-center gap-1.5 p-2 -m-2" aria-label={item.label}>
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4 flex-shrink-0">
                    <path d={item.icon} />
                  </svg>
                  <span class="nav-label max-sm:hidden transition-[width,opacity] duration-300 overflow-hidden whitespace-nowrap">{item.label}</span>
                </a>
              </li>
            ))}
          </ul>
          <button
            id="motion-toggle"
            type="button"
            aria-label="Animations"
            aria-pressed="true"
            title="Animations: on / calm"
            class="flex items-center gap-1.5 font-sans text-sm text-body bar-link cursor-pointer"
          >
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5 motion-on">
              <path d="M12 3l1.8 5.2L19 10l-5.2 1.8L12 17l-1.8-5.2L5 10l5.2-1.8z"/><path d="M19 17v4M17 19h4"/>
            </svg>
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" class="w-5 h-5 motion-off">
              <path d="M9 5v14M15 5v14"/>
            </svg>
            <span class="nav-label max-sm:hidden transition-[width,opacity] duration-300 overflow-hidden whitespace-nowrap">Animations</span>
          </button>
          <button
            id="theme-toggle"
            type="button"
            aria-label="Toggle dark mode"
            class="flex items-center gap-1.5 font-sans text-sm text-body bar-link cursor-pointer"
          >
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-5 h-5 when-light">
              <path d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.36 6.36l-.71-.71M6.34 6.34l-.71-.71m12.02 0l-.71.71M6.34 17.66l-.71.71M16 12a4 4 0 11-8 0 4 4 0 018 0z"/>
            </svg>
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-5 h-5 when-dark">
              <path d="M21 12.79A9 9 0 1111.21 3 7 7 0 0021 12.79z"/>
            </svg>
            <span class="nav-label max-sm:hidden transition-[width,opacity] duration-300 overflow-hidden whitespace-nowrap">Theme</span>
          </button>
        </div>
      </nav>
    </header>

    <main class="max-w-3xl mx-auto w-full px-4 py-10 flex-1">
      <slot />
    </main>

    <footer class="border-t border-rule">
      <p class="max-w-3xl mx-auto px-4 py-6 font-sans text-sm text-body">
        &copy; {new Date().getFullYear()} Will Martin
      </p>
    </footer>

    <script is:inline>
      // The new theme spreads out as a circle from the toggle (View Transitions); browsers without
      // them switch instantly.
      // Eased section jumps: the nav links glide to their section with a gentle ease (slower for longer
      // distances), opening a closed section on arrival. Wheel, touch or key input cancels it at once,
      // so ordinary scrolling is never touched. Calm mode and unsupported cases use the plain jump.
      const easeInOut = (t) => (t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2);
      let glide = 0;
      const cancelGlide = () => {
        glide++;
      };
      for (const evt of ["wheel", "touchstart", "keydown", "mousedown"])
        addEventListener(evt, cancelGlide, { passive: true });
      document.querySelectorAll('header a[href^="/#"], header a[href="/"]').forEach((link) => {
        link.addEventListener("click", (e) => {
          if (location.pathname !== "/" || e.metaKey || e.ctrlKey || e.shiftKey || e.button !== 0) return;
          const hash = link.getAttribute("href").slice(1);
          // The name at the top goes home: scroll to the top and drop any #section from the address.
          const home = hash.length <= 1;
          if (document.documentElement.dataset.motion === "calm") {
            if (home) {
              e.preventDefault();
              scrollTo({ top: 0, behavior: "instant" });
              history.replaceState(null, "", location.pathname + location.search);
            }
            return;
          }
          const target = hash.length > 1 ? document.querySelector(hash.slice(1)) : null;
          if (hash.length > 1 && !target) return;
          e.preventDefault();
          if (target instanceof HTMLDetailsElement) target.open = true;
          const margin = target ? parseFloat(getComputedStyle(target).scrollMarginTop) || 0 : 0;
          const from = scrollY;
          const to = Math.max(0, Math.round(target ? target.getBoundingClientRect().top + scrollY - margin : 0));
          const distance = Math.abs(to - from);
          if (distance < 4) {
            if (home) history.replaceState(null, "", location.pathname + location.search);
            return;
          }
          const duration = Math.min(1500, 550 + distance * 0.45);
          const mine = ++glide;
          const t0 = performance.now();
          const step = (now) => {
            if (mine !== glide) return; // the visitor took over
            const t = Math.min(1, (now - t0) / duration);
            scrollTo({ top: from + (to - from) * easeInOut(t), behavior: "instant" });
            if (t < 1) requestAnimationFrame(step);
            else history.replaceState(null, "", hash.length > 1 ? hash : location.pathname + location.search);
          };
          requestAnimationFrame(step);
        });
      });

      const motionButton = document.getElementById("motion-toggle");
      const syncMotionButton = () =>
        motionButton.setAttribute("aria-pressed", String(document.documentElement.dataset.motion === "full"));
      syncMotionButton();
      motionButton.addEventListener("click", () => {
        const next = document.documentElement.dataset.motion === "calm" ? "full" : "calm";
        document.documentElement.dataset.motion = next;
        try {
          localStorage.setItem("motion", next);
        } catch {}
        syncMotionButton();
        window.dispatchEvent(new Event("motionchange"));
      });

      // ---- Theme change: an enchanted veil. Mist rolls out from the toggle with a cool glow along its
      // front, and fae lights (the same kind as the wisp) wake in it as it passes, drift a little and
      // fade, while the new theme is revealed behind the edge.

      // A soft fog texture (fractal noise), rasterised once and tiled.
      // Built once per colour and reused, so the browser rasterises each turbulence tile a single time
      // (a fresh seed on every toggle meant re-rendering it mid-transition) and can warm it in advance.
      const fogTiles = {};
      const fogTile = (warm) => {
        const key = warm ? "warm" : "cool";
        if (fogTiles[key]) return fogTiles[key];
        const svg =
          "<svg xmlns='http://www.w3.org/2000/svg' width='900' height='600'><filter id='f' x='0' y='0' width='100%' height='100%'>" +
          "<feTurbulence type='fractalNoise' baseFrequency='.007 .011' numOctaves='3' seed='" + (warm ? 7 : 31) + "' stitchTiles='stitch'/>" +
          "<feColorMatrix values='" + (warm ? "0 0 0 0 1  0 0 0 0 .78  0 0 0 0 .42" : "0 0 0 0 .70  0 0 0 0 .80  0 0 0 0 1") + "  2.1 0 0 0 -.78'/></filter>" +
          "<rect width='100%' height='100%' filter='url(%23f)'/></svg>";
        return (fogTiles[key] = `url("data:image/svg+xml,${svg.replace(/#/g, "%23").replace(/</g, "%3C").replace(/>/g, "%3E")}")`);
      };
      if (document.documentElement.dataset.motion !== "calm" && !matchMedia("(pointer: coarse)").matches) {
        const warmUp = () => {
          for (const warm of [false, true]) {
            const probe = document.createElement("div");
            probe.style.cssText = `position:fixed;left:0;top:0;width:1px;height:1px;opacity:.01;pointer-events:none;background-image:${fogTile(warm)}`;
            document.body.appendChild(probe);
            setTimeout(() => probe.remove(), 1500);
          }
        };
        addEventListener("load", () => (window.requestIdleCallback || setTimeout)(warmUp));
      }

      // warm: the dawn version, used going to the light theme (golden mist and glow).
      const drawVeil = (ring, x, y, radius, progress, done, warm) => {
        const [cr, cg, cb] = warm ? [255, 170, 55] : [150, 175, 255];
        // fog: rolls in just ahead of the reveal edge and fades away as it reaches the page edges
        const mist = document.createElement("div");
        mist.style.cssText = "position:absolute;inset:0;overflow:hidden";
        const fog = document.createElement("div");
        fog.style.cssText = `position:absolute;inset:-320px;background-image:${fogTile(warm)};background-size:900px 600px`;
        mist.appendChild(fog);
        fog.animate([{ transform: "translate(0,0)" }, { transform: "translate(-320px,-70px)" }], { duration: 2600, easing: "linear", fill: "forwards" });
        // a cool glow along the very front of the reveal
        const rim = document.createElement("div");
        rim.style.cssText = "position:absolute;inset:0";
        ring.append(mist, rim);

        // fae lights: scattered around the toggle; each wakes when the front reaches it
        const motes = Array.from({ length: matchMedia("(pointer: coarse)").matches ? 28 : 70 }, () => {
          const d = Math.sqrt(Math.random()) * radius * 0.92;
          const a = Math.random() * 6.283;
          return { d, px: x + Math.cos(a) * d, py: y + Math.sin(a) * d, size: 2 + Math.random() * 3.2, born: false };
        }).filter((m) => m.px > -10 && m.py > -10 && m.px < innerWidth + 10 && m.py < innerHeight + 10);
        let active = 0;
        const wake = (m) => {
          m.born = true;
          const el = document.createElement("span");
          const sz = m.size * 0.85;
          // small glowing lights, in the same colour as the wisp (the page's body colour)
          // The glow is a radial gradient, not a box-shadow: large blurred shadows are costly to rasterise
          // when dozens wake in the same few frames.
          const box = sz * 12;
          el.style.cssText = `position:absolute;left:${m.px}px;top:${m.py}px;width:${box}px;height:${box}px;margin:${-box / 2}px 0 0 ${-box / 2}px;border-radius:50%;background:radial-gradient(circle,var(--color-body) 0,var(--color-body) ${(sz / 2 / (box / 2)) * 100}%,color-mix(in srgb,var(--color-body) 45%,transparent) ${(sz / (box / 2)) * 100}%,color-mix(in srgb,var(--color-body) 12%,transparent) 45%,transparent 70%)`;
          ring.appendChild(el);
          active++;
          const dx = (Math.random() - 0.5) * 30;
          const dy = -(24 + Math.random() * 42);
          el.animate(
            [
              { opacity: 0, transform: "translate(0,0) scale(.4)" },
              { opacity: 1, transform: `translate(${dx * 0.2}px,${dy * 0.2}px) scale(1)`, offset: 0.12 },
              { opacity: 0.8, transform: `translate(${dx * 0.7}px,${dy * 0.7}px) scale(.9)`, offset: 0.65 },
              { opacity: 0, transform: `translate(${dx}px,${dy}px) scale(.5)` },
            ],
            { duration: 1500 + Math.random() * 1000, easing: "ease-out" },
          ).finished.then(() => {
            el.remove();
            active--;
          });
        };

        const tick = () => {
          if (!ring.isConnected) return;
          const p = progress();
          const outer = radius * p;
          const grad = `radial-gradient(circle at ${x}px ${y}px, transparent ${outer - 600}px, #000 ${outer - 300}px, #000 ${outer - 20}px, transparent ${outer + 150}px)`;
          mist.style.webkitMaskImage = grad;
          mist.style.maskImage = grad;
          mist.style.opacity = String((warm ? 0.65 : 0.5) * Math.min(1, (1 - p) / 0.35));
          const rimA = 0.55 * Math.min(1, (1 - p) / 0.25);
          rim.style.background = `radial-gradient(circle at ${x}px ${y}px, transparent ${outer - 46}px, rgba(${cr},${cg},${cb},${rimA}) ${outer - 5}px, rgba(${Math.min(255, cr + 40)},${Math.min(255, cg + 30)},${Math.min(255, cb + 0)},${rimA * 0.4}) ${outer + 3}px, transparent ${outer + 16}px)`;
          // they wake just ahead of the edge, so each is already glowing as the front reaches it
          for (const m of motes) if (!m.born && outer >= m.d - 150) wake(m);
          if (done() && active === 0) return ring.remove();
          requestAnimationFrame(tick);
        };
        tick();
      };

      // Wheel, touch and scroll keys are held off while the change plays: the transition layers are
      // frozen to the viewport, so scrolling under them glitches.
      const SCROLL_KEYS = new Set([" ", "PageUp", "PageDown", "Home", "End", "ArrowUp", "ArrowDown"]);
      const stopScroll = (e) => {
        if (e.type !== "keydown" || SCROLL_KEYS.has(e.key)) e.preventDefault();
      };
      const lockScroll = (on) => {
        const fn = on ? "addEventListener" : "removeEventListener";
        for (const evt of ["wheel", "touchmove", "keydown"]) window[fn](evt, stopScroll, { passive: false });
      };

      // Everything the running theme transition added, so a new toggle can clear it: leftover layer
      // names make the browser abort the next transition. The veil element itself is left to finish
      // fading on its own (lights still drifting) unless a new toggle forces it away.
      let vt = null;
      const endVt = (force) => {
        // Held colours go first, and settle with colour transitions still off, or they would fade.
        vt?.cleanup?.();
        void document.documentElement.offsetWidth;
        document.documentElement.classList.remove("vt-run");
        document.documentElement.style.cursor = "";
        lockScroll(false);
        if (!vt) return;
        vt.style?.remove();
        vt.live?.forEach((el) => (el.style.viewTransitionName = ""));
        if (vt.ring) {
          vt.ring.style.viewTransitionName = "";
          if (force) vt.ring.remove();
        }
        vt = null;
      };

      // Every visible element that carries its own colour (text, a border or background, an image or icon),
      // nearest to the toggle first. Creatures and blog text count as one piece each, since their colours
      // are set on the element itself. Elements off screen are not held; they change with the page.
      const ATOMIC = ".wyv,.scribe,.wisp,.prose";
      const NOT_THEMED = new Set(["SCRIPT", "STYLE", "TEMPLATE", "NOSCRIPT", "LINK", "META"]);
      const themedRegions = (x, y) => {
        const out = [];
        // Text with no colour of its own inherits the body's, which the flip changes at once; those
        // elements also pin it (t-body) so they show the token set they are held in.
        const bodyColor = getComputedStyle(document.body).color;
        for (const el of document.body.querySelectorAll("*")) {
          if (NOT_THEMED.has(el.tagName) || el.ownerSVGElement || el.classList.contains("theme-veil")) continue;
          const r = el.getBoundingClientRect();
          if (!r.width || !r.height || r.bottom < 0 || r.top > innerHeight || r.right < 0 || r.left > innerWidth) continue;
          const atomic = el.closest(ATOMIC);
          if (atomic && atomic !== el) continue;
          let own = !!atomic || el.childElementCount === 0;
          if (!own) for (const n of el.childNodes) if (n.nodeType === 3 && n.nodeValue.trim()) own = true;
          if (!own) {
            const cs = getComputedStyle(el);
            own =
              cs.backgroundImage !== "none" ||
              cs.backgroundColor !== "rgba(0, 0, 0, 0)" ||
              cs.borderTopWidth !== "0px" ||
              cs.borderBottomWidth !== "0px" ||
              cs.borderLeftWidth !== "0px" ||
              cs.borderRightWidth !== "0px";
          }
          if (!own && !(el instanceof SVGElement)) continue;
          // Large pieces change when the edge first touches them; the rest when it reaches their middle.
          const large = r.width > 600 || r.height > 400;
          const px = large ? Math.min(Math.max(x, r.left), r.right) : r.left + r.width / 2;
          const py = large ? Math.min(Math.max(y, r.top), r.bottom) : r.top + r.height / 2;
          out.push({ el, d: Math.hypot(px - x, py - y), body: getComputedStyle(el).color === bodyColor });
        }
        return out.sort((a, b) => a.d - b.d);
      };

      // The veil outlives the transition that drew it; fade it out rather than cut it.
      const dismissVeil = (ring) => ring.animate({ opacity: [1, 0] }, { duration: 350, fill: "forwards" }).finished.then(() => ring.remove());

      // While a view transition runs the page behind it is not hit-testable: the toggle's clicks land on
      // <html>, and so does the hover, which loses its pointer cursor. Catch both and check where the
      // pointer is, so the toggle can still reverse the change.
      const overToggle = (e) => {
        const r = document.getElementById("theme-toggle").getBoundingClientRect();
        return e.clientX >= r.left && e.clientX <= r.right && e.clientY >= r.top && e.clientY <= r.bottom;
      };
      addEventListener(
        "click",
        (e) => {
          if (e.target === document.documentElement && vt?.reverse && overToggle(e)) vt.reverse();
        },
        true,
      );
      addEventListener(
        "pointermove",
        (e) => {
          if (e.target === document.documentElement && vt?.reverse) {
            document.documentElement.style.cursor = overToggle(e) ? "pointer" : "";
          }
        },
        { passive: true },
      );

      document.getElementById("theme-toggle").addEventListener("click", (e) => {
        const flip = () => {
          const isDark = document.documentElement.classList.toggle("dark");
          try {
            localStorage.setItem("theme", isDark ? "dark" : "light");
          } catch {}
          document.querySelector('meta[name="color-scheme"]').content = isDark ? "dark" : "only light";
        };
        if (document.documentElement.dataset.motion === "calm") return flip();
        // A click while the change is playing runs it backwards, from the same point.
        if (vt?.reverse) return vt.reverse();
        if (vt) vt.transition?.skipTransition?.();
        endVt(true);
        document.querySelectorAll(".theme-veil").forEach((n) => n.remove());
        const x = e.clientX;
        const y = e.clientY;
        const radius = Math.hypot(Math.max(x, innerWidth - x), Math.max(y, innerHeight - y));
        const DURATION = 1500;

        // Going to light plays the dawn version, going to dark the moonlit one.
        const warm = document.documentElement.classList.contains("dark");
        // Colour transitions would be caught half-way by the snapshot and jump when it ends.
        document.documentElement.classList.add("vt-run");
        // The pointer is still on the toggle (no move event yet), so keep its hand until one arrives.
        if (e.detail > 0) document.documentElement.style.cursor = "pointer";
        lockScroll(true);
        const ring = document.createElement("div");
        ring.className = "theme-veil";
        ring.style.cssText = "position:fixed;inset:0;pointer-events:none;z-index:2147483646";

        // No View Transitions, or a touch device (the full-page snapshot glitched there): no snapshot at
        // all. The theme flips at once, but every visible element is held in the old colours (its own
        // token class) and released as the circle reaches it, so text and creatures change where the edge
        // passes, as in the View Transition version. Only the paper is a layer: the old one underneath,
        // the new one growing over it, both behind the content.
        if (!document.startViewTransition || matchMedia("(pointer: coarse)").matches) {
          const wasDark = document.documentElement.classList.contains("dark");
          const oldCls = wasDark ? "t-dark" : "t-light";
          const newCls = wasDark ? "t-light" : "t-dark";
          const regions = themedRegions(x, y);
          const paper = (cls) => {
            const d = document.createElement("div");
            d.className = cls;
            d.style.cssText = `position:fixed;inset:0;z-index:-1;pointer-events:none;background:var(--color-paper) var(--paper-grain) 0 ${-scrollY}px/var(--paper-size)`;
            return d;
          };
          const under = paper(oldCls);
          const over = paper(newCls);
          over.style.clipPath = `circle(0px at ${x}px ${y}px)`;
          for (const r of regions) r.el.classList.add(oldCls, ...(r.body ? ["t-body"] : []));
          document.documentElement.classList.add("tw-run");
          document.body.prepend(under, over);
          flip();
          document.body.appendChild(ring);

          const release = (r) => {
            r.el.classList.remove(oldCls);
            r.el.classList.add(newCls);
          };
          const cleanup = () => {
            for (const r of regions) r.el.classList.remove(oldCls, newCls, "t-body");
            under.remove();
            over.remove();
            document.documentElement.classList.remove("tw-run");
          };
          const hold = (r) => {
            r.el.classList.remove(newCls);
            r.el.classList.add(oldCls);
          };
          // t is the position along the change (0 = old theme, 1 = new); a click flips the direction.
          let t = 0;
          let dir = 1;
          let last = performance.now();
          const prog = () => (t < 0.5 ? 2 * t * t : 1 - 2 * (1 - t) * (1 - t));
          vt = {
            ring,
            cleanup,
            reverse: () => {
              dir = -dir;
            },
          };
          let next = 0;
          const sweep = (now) => {
            if (!ring.isConnected || !over.isConnected) return;
            t = Math.min(1, t + (dir * Math.max(0, now - last)) / DURATION);
            last = now;
            const p = prog();
            const outer = radius * p;
            over.style.clipPath = `circle(${outer}px at ${x}px ${y}px)`;
            while (next < regions.length && (p >= 1 || regions[next].d <= outer)) release(regions[next++]);
            while (next > 0 && regions[next - 1].d > outer) hold(regions[--next]);
            if (dir < 0 && t <= 0) {
              flip();
              void document.documentElement.offsetWidth; // settle the colours before transitions come back
              dismissVeil(ring);
              cleanup();
              return endVt(false);
            }
            if (t < 1) return requestAnimationFrame(sweep);
            if (vt && vt.ring === ring) endVt(false);
          };
          sweep(last);
          drawVeil(ring, x, y, radius, prog, () => t >= 1, warm);
          // rAF stalls in background tabs and some in-app browsers; don't leave the page held.
          const guard = () => {
            if (!vt || vt.ring !== ring) return;
            if (performance.now() - last > 1000) return endVt(false);
            setTimeout(guard, 1000);
          };
          setTimeout(guard, 1000);
          return;
        }

        // The page is a frozen snapshot outside the circle. Anything animated gets its own transition
        // layer so it keeps moving, and (like the page) changes theme only where the circle has reached.
        const live = [document.getElementById("site-header")];
        // Anything that moves (creatures, the covers' motes and effects) cannot be a frozen snapshot outside
        // the circle: it would jump to its live state when it reaches it (and back again on a reverse). Each
        // is its own layer, shown live throughout and held in the old colours until the circle reaches it,
        // as on touch devices.
        const wasDark = document.documentElement.classList.contains("dark");
        const [oldCls, newCls] = wasDark ? ["t-dark", "t-light"] : ["t-light", "t-dark"];
        const held = [
          ...document.querySelectorAll(".scribe, .wyv, .wisp-layer"),
          ...[...document.querySelectorAll("[data-cover]")].map((el) => el.parentElement),
        ]
          .map((el) => ({ el, rect: el.getBoundingClientRect(), released: false }))
          .filter((c) => c.rect.width && c.rect.height)
          // Measured to the middle, kept on screen: a tall piece centred below the fold must still be reached.
          .map((c) => ({
            ...c,
            d: Math.hypot(
              Math.min(Math.max(c.rect.left + c.rect.width / 2, 0), innerWidth) - x,
              Math.min(Math.max(c.rect.top + c.rect.height / 2, 0), innerHeight) - y,
            ),
          }));
        let css = "::view-transition-old(root),::view-transition-new(root){animation:none}";
        held.forEach((c, i) => {
          c.el.classList.add(oldCls);
          c.el.style.viewTransitionName = `held-${i}`;
          css += `::view-transition-old(held-${i}){display:none}::view-transition-new(held-${i}){animation:none}::view-transition-group(held-${i}){animation-duration:0s}`;
        });
        live.forEach((el, i) => {
          el.style.viewTransitionName = `live-${i}`;
          css += `::view-transition-old(live-${i}){animation:none}::view-transition-new(live-${i}){animation:none}::view-transition-group(live-${i}){animation-duration:0s}`;
        });
        ring.style.viewTransitionName = "ring";
        css += "::view-transition-old(ring){display:none}::view-transition-new(ring){animation:none}::view-transition-group(ring){animation-duration:0s}";
        const style = document.createElement("style");
        style.textContent = css;
        document.head.appendChild(style);
        document.body.appendChild(ring);

        // A layer's clip circle is measured from the layer's own corner, not the page's, so each one is
        // offset by where its element sits, or the colour would change out of step with the page.
        const origins = live.map((el) => el.getBoundingClientRect());
        const transition = document.startViewTransition(flip);
        vt = {
          transition,
          live,
          style,
          ring,
          cleanup: () =>
            held.forEach((c) => {
              c.el.classList.remove(oldCls, newCls);
              c.el.style.viewTransitionName = "";
            }),
        };
        transition.ready.then(() => {
          const clip = { clipPath: [`circle(0px at ${x}px ${y}px)`, `circle(${radius}px at ${x}px ${y}px)`] };
          const timing = { duration: DURATION, easing: "cubic-bezier(.45,.05,.3,1)", fill: "forwards" };
          const reveal = document.documentElement.animate(clip, { ...timing, pseudoElement: "::view-transition-new(root)" });
          const layers = live.map((_, i) =>
            document.documentElement.animate(
              { clipPath: [`circle(0px at ${x - origins[i].left}px ${y - origins[i].top}px)`, `circle(${radius}px at ${x - origins[i].left}px ${y - origins[i].top}px)`] },
              { ...timing, pseudoElement: `::view-transition-new(live-${i})` },
            ),
          );
          if (vt?.transition !== transition) return;
          let frozen = null;
          // Run back to the old theme. Stopping a frame short of 0 matters: once the animations finish the
          // browser ends the transition on its own and the new theme would flash up before we flip back.
          const revert = () => {
            frozen = 0;
            flip();
            void document.documentElement.offsetWidth; // settle the colours before transitions come back
            transition.skipTransition();
            dismissVeil(ring);
            endVt(false);
          };
          vt.reverse = () => [reveal, ...layers].forEach((a) => a.reverse());
          vt.reversing = () => reveal.playbackRate < 0;
          const watch = () => {
            if (vt?.transition !== transition) return;
            if (reveal.playbackRate < 0 && (reveal.currentTime ?? 0) <= 40) return revert();
            const outer = radius * (reveal.effect.getComputedTiming().progress ?? 1);
            for (const c of held) {
              if (c.released === outer >= c.d) continue;
              c.released = !c.released;
              c.el.classList.toggle(oldCls, !c.released);
              c.el.classList.toggle(newCls, c.released);
            }
            requestAnimationFrame(watch);
          };
          watch();
          drawVeil(ring, x, y, radius, () => frozen ?? reveal.effect.getComputedTiming().progress ?? 1, () => reveal.playState === "finished", warm);
        }, () => {});
        transition.finished.finally(() => {
          if (vt?.transition !== transition) return;
          // Ended by the browser while running backwards (a click in the last frames, or a skip): the
          // visitor asked for the old theme, so go there.
          if (vt.reversing?.()) {
            flip();
            dismissVeil(ring);
          }
          endVt(false);
        });
      });

      // Compact the header on scroll: shrink padding, collapse nav labels
      // down to icon-only (navigation stays available, just smaller), and
      // thin the background so it stops blocking the read. Skipped on phones:
      // labels are always hidden there, and any height change would shift the
      // scroll position back across the threshold and make the header flicker.
      const siteNav = document.getElementById("site-nav");
      const navLabels = document.querySelectorAll(".nav-label");
      const siteHeader = document.getElementById("site-header");
      const onScroll = () => {
        const scrolled = window.scrollY > 24;
        const compactable = window.matchMedia("(min-width: 40rem)").matches;
        siteNav.classList.toggle("py-4", !(scrolled && compactable));
        siteNav.classList.toggle("py-2", scrolled && compactable);
        navLabels.forEach((el) => {
          if (!compactable) {
            el.style.width = "";
            el.style.opacity = "";
            return;
          }
          el.style.width = scrolled ? "0px" : el.scrollWidth + "px";
          el.style.opacity = scrolled ? "0" : "1";
        });
        siteHeader.classList.toggle("bg-bar/90", !scrolled);
        siteHeader.classList.toggle("bg-bar/40", scrolled);
      };
      window.addEventListener("scroll", onScroll, { passive: true });
      window.addEventListener("resize", onScroll);
      onScroll();
      // Browsers may restore the scroll position after the first paint; let that settle
      // without animating the header, then enable the transitions.
      window.addEventListener("load", () => setTimeout(() => siteHeader.classList.remove("no-anim"), 200));
    </script>
  </body>
</html>
